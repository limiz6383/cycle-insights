<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd job: pull Oura data every morning at 08:00.
  Install with the commands under "Automatic pull" in README.md, which fill in
  __REPO__ and __PYTHON__. If the Mac is asleep at 08:00, launchd runs the job
  once on wake.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cycleinsights.oura-pull</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__REPO__/scripts/scheduled_pull.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__/scripts</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/launchd.err.log</string>
</dict>
</plist>
