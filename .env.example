# Copy to .env and fill in. .env is gitignored — never commit it.

# Oura personal access token: https://cloud.ouraring.com/personal-access-tokens
OURA_TOKEN=

# Anthropic API key (or use `ant auth login` and leave this blank)
ANTHROPIC_API_KEY=

# Telegram: message @BotFather, /newbot, copy the token here
TELEGRAM_BOT_TOKEN=
# Then message your bot once and run: python3 scripts/send_insight.py --discover-chat-id
TELEGRAM_CHAT_ID=
